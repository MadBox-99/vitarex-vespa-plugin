# Másold le ezt a fájlt deploy.env néven, és töltsd ki a saját szervered adataival.
# A deploy.env a .gitignore-ban van, így NEM kerül a verziókövetésbe.
# Csak a ./build.sh --upload használja (scp-vel tölti fel a kész ZIP-et).

SSH_HOST="pelda-szerver.hu"
SSH_USER="deploy"
SSH_PORT="22"

# Ide tölti fel a ZIP-et (a szerveren ennek a mappának léteznie kell).
REMOTE_UPLOAD_DIR="/home/deploy/uploads"

# Opcionális SSH privát kulcs útvonala. Hagyd üresen, ha jelszavas/agent auth van.
SSH_KEY=""
